{
  "name": "zumen",
  "private": true,
  "version": "0.0.1",
  "description": "単線結線図作成アプリ",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "catalog": "node --experimental-strip-types scripts/build-catalog.ts",
    "typecheck": "tsc -b",
    "sample": "node --experimental-strip-types scripts/build-sample-drawing.ts",
    "check": "node --experimental-strip-types scripts/check-knowledge.ts",
    "dev": "pnpm --filter @zumen/web dev",
    "build": "pnpm --filter @zumen/web build"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}

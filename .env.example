# 解析サーバー（apps/server）が使うClaude APIキー。
# このキーはサーバーにだけ置き、利用者の端末やブラウザには配らない。
ANTHROPIC_API_KEY=sk-ant-...

# 解析サーバーのポート（既定 8787）
PORT=8787

# 社内の他のパソコンからの直接のつなぎ方（http）を閉じる設定（省略可）。
# 書かなければ、社内の他のパソコンから http://192.168.x.x:8787 で開ける。
# 運用開始日に、https の住所（Cloudflare 経由）で開けると確かめたあと、下の行の先頭の # を消す。
# 社内からも https の住所だけを使うことになり、IDとパスワードが暗号化される。
# 戻すときは、行の先頭に # を付けて、サーバーを起動し直す（インターネット回線が止まったときの、非常用）。
# LISTEN_HOST=127.0.0.1

# 案件の控えの保存先（省略可）。
# ドロップボックス等の同期フォルダを指定すると、1日1回そこへ控えが作られ、
# そのままクラウドに上がる。30世代まで残し、古いものから消える。
#   例（Mac）    : BACKUP_DIR=/Users/ユーザー名/Dropbox/単線結線図_控え
#   例（Windows）: BACKUP_DIR=C:/Users/ユーザー名/Dropbox/単線結線図_控え
# BACKUP_DIR=

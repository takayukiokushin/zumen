# 解析サーバー（apps/server）が使うClaude APIキー。
# このキーはサーバーにだけ置き、利用者の端末やブラウザには配らない。
ANTHROPIC_API_KEY=sk-ant-...

# 解析サーバーのポート（既定 8787）
PORT=8787

# 案件の控えの保存先（省略可）。
# ドロップボックス等の同期フォルダを指定すると、1日1回そこへ控えが作られ、
# そのままクラウドに上がる。30世代まで残し、古いものから消える。
#   例（Mac）    : BACKUP_DIR=/Users/ユーザー名/Dropbox/単線結線図_控え
#   例（Windows）: BACKUP_DIR=C:/Users/ユーザー名/Dropbox/単線結線図_控え
# BACKUP_DIR=
